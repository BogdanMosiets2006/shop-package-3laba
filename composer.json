{
    "name": "bogdanmosiets2006/shop-package-3laba",
    "description": "Abstract internet shop Laravel package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mosiets Bogdan",
            "email": "dr4gon.0023@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
"illuminate/database": "^10.0|^11.0|^12.0",
"illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\ShopPackage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\ShopPackage\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\ShopPackage\\ShopServiceProvider"
            ],
            "aliases": {
                "CurrencyRate": "Vendor\\ShopPackage\\Facades\\CurrencyRate",
                "DeliveryCalculator": "Vendor\\ShopPackage\\Facades\\DeliveryCalculator"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
